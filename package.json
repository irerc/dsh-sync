{
  "name": "dsh-sync",
  "version": "1.7.0",
  "description": "多设备文件型同步：把 DSH 配置、会话与工作区内容通过本地目录 / WebDAV / 对等 DSH / .dshsync 归档无缝同步。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/**/*.js",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "SPEC.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "author": "irerc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/irerc/dsh-sync.git"
  },
  "homepage": "https://github.com/irerc/dsh-sync#readme",
  "bugs": {
    "url": "https://github.com/irerc/dsh-sync/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "sync",
    "webdav",
    "p2p",
    "file-sync",
    "deepseek-harness"
  ]
}
